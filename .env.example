# Copy to `.env` on the server. Never commit `.env`.

PORT=3001
TZ=Europe/Rome

# Public URL (Tailscale IP recommended). No trailing slash.
# Example: http://100.x.y.z:3001
APP_BASE_URL=http://localhost:3001

# --- Local development (npm run dev) ---
PHOTOS_DIR=./Photos
THUMBNAILS_DIR=./thumbnails
TRASH_DIR=./.trash
DATA_DIR=./data

# --- Docker (set automatically in docker-compose.yml) ---
# PHOTOS_DIR=/photos
# THUMBNAILS_DIR=/thumbnails
# TRASH_DIR=/trash
# DATA_DIR=/data

# Upload limits
MAX_UPLOAD_MB=200
MAX_UPLOAD_FILES=100
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,heic,heif,gif,mp4,mov,m4v

# Thumbnail size (longest edge in pixels)
THUMB_MAX_PX=400

# Single shared login — CHANGE BEFORE GOING ONLINE
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-a-long-secret

# strict = delete folders only when completely empty
FOLDER_DELETE_MODE=strict
REQUIRE_TYPED_CONFIRMATION=true

# Trash: after TRASH_RETENTION_DAYS you must confirm before permanent delete
TRASH_RETENTION_DAYS=7
TRASH_POSTPONE_DAYS=3

# Login brute-force protection
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Session duration (milliseconds). Default: 30 days.
SESSION_TTL_MS=2592000000
