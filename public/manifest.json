{
  "name": "ViewPhoto",
  "short_name": "ViewPhoto",
  "description": "Galleria foto personale sul mini server",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f1f3f7",
  "theme_color": "#4f46e5",
  "orientation": "any",
  "icons": [
    {
      "src": "/assets/logo-mark.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/api/upload/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "photos",
          "accept": ["image/*", ".heic", ".heif"]
        }
      ]
    }
  }
}
