# Copy to deploy.env (gitignored) for scripts/deploy-to-pi.sh
#
#   cp scripts/deploy.env.example scripts/deploy.env
#   nano scripts/deploy.env

# SSH target
PI_USER=pi
PI_HOST=100.x.y.z
PI_PATH=/home/pi/view-photo-mini-server

# Optional: external photo mount on the Pi (matches docker-compose.override.yml)
# If set, deploy will create these folders and fix permissions.
# Example: /mnt/FotoSanDisk or /mnt/usb
PHOTOS_MOUNT=
